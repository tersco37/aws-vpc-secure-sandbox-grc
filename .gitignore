# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which can contain sensitive data
*.tfvars
*.tfvars.json

# Ignore developer specific overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include .terraform.lock.hcl if you want locked dependencies, or ignore it if preferred
.terraform.lock.hcl
